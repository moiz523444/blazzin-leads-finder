# Copy this file to .env and fill in the keys you have. All are free and optional.

# TomTom Search API - main source of verified local businesses (phone, website, address)
# Sign up: https://developer.tomtom.com  ->  Dashboard -> Keys  (2,500 free Search requests/month)
TOMTOM_API_KEY=

# Google PageSpeed Insights - real mobile performance audit of each lead's website
# Google Cloud console -> APIs & Services -> enable "PageSpeed Insights API" -> Credentials -> API key
PAGESPEED_API_KEY=

# USPTO TSDR API - trademark leads twice as fast (60 lookups/minute instead of 30)
# Register: https://account.uspto.gov/api-manager/
USPTO_API_KEY=
